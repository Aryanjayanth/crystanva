# Copy to .env (local) or add in Vercel > Settings > Environment Variables
# 1. Message @BotFather on Telegram -> /newbot -> copy the token
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates  and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
# One id, or several separated by commas (you + friends + groups): 123456,-100987654
TELEGRAM_CHAT_ID=

# Set automatically: lets only Telegram press the review Approve/Reject buttons
TELEGRAM_WEBHOOK_SECRET=
# Created by Vercel when the Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=
